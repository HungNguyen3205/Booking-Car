{
  "name": "datvexeonl",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev-full.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:journey": "node scripts/verify-journey.cjs",
    "test:hero": "node scripts/verify-journey.cjs --hero-only",
    "test:logic": "node scripts/verify-logic.cjs",
    "test:navigation": "node scripts/verify-search-navigation.cjs",
    "test:surfaces": "node scripts/verify-surfaces.cjs",
    "test:audit": "node scripts/verify-audit.cjs",
    "dev:web": "vite",
    "start": "php -S 127.0.0.1:8787 -t backend/public backend/server.php",
    "test:server": "node --test backend/tests/api-contract.test.mjs",
    "test:studio": "node --test backend/tests/studio-live.test.mjs",
    "test:crew": "node --test backend/tests/crew-tracking.test.mjs",
    "test:php": "php backend/vendor/bin/phpunit -c backend/phpunit.xml",
    "build:hosting": "npm run build && node scripts/build-hosting.mjs"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^14.6.0",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.61.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0 <25"
  }
}
