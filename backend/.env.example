APP_NAME="DANAVA GO"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8787
DB_CONNECTION=sqlite
# For SQLite, use an ABSOLUTE path to an existing empty file.
# DB_DATABASE=/absolute/path/to/backend/database/database.sqlite
# For cPanel production: DB_CONNECTION=mysql and configure these credentials locally.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=cpanel_danava
# DB_USERNAME=cpanel_danava
# DB_PASSWORD=
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=false
DANAVA_SETUP_TOKEN=
DANAVA_ALLOW_DEMO_SEED=true

MARKETPLACE_HOST=danavago.com
OPERATOR_PROFILE_HOST=danava.com
PLATFORM_APP_HOST=app.danavago.com
TENANT_APP_ROOT=danavago.com
# Set true only after *.danavago.com DNS, virtual host and SSL are ready.
TENANT_WILDCARD_READY=false
