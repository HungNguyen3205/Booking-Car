# Frontend / local launcher only. Laravel settings belong in backend/.env.
# PHP_BINARY=php
# VITE_BOOKING_MODE=demo

# Map tiles for GPS tracking (Leaflet). Default: public OpenStreetMap (rate-limited, demo only).
# Production: a tile provider URL, e.g. https://api.maptiler.com/maps/streets/{z}/{x}/{y}.png?key=YOUR_KEY
# VITE_MAP_TILE_URL=
# VITE_MAP_ATTRIBUTION=
